{
    "name": "yu-laravel/laravel-web-tools-core",
    "description": "Shared core for the yu-laravel web tools: SSRF-safe page fetcher, TLS inspector, checklist report, base Livewire tool component and locale resolver.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "seo",
        "ssrf",
        "checklist"
    ],
    "homepage": "https://github.com/yuriyakishin/laravel-web-tools-core",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuriy Akishin",
            "email": "yuriy.akishin@gmail.com",
            "homepage": "https://yu.net.ua"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Yu\\WebToolsCore\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Yu\\WebToolsCore\\WebToolsCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
